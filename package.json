{
  "name": "cycle-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "Google Apps Script that predicts menstrual cycle phases from a Sheet and writes them to a private Google Calendar.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksarad/cycle-calendar.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "push": "npm run build && clasp push"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
